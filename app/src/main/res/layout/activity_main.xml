<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="تنظیمات فوروارد پیامک"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"/>

    <EditText
        android:id="@+id/etSourceNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="شماره مبدأ (مثلا 0912...)"
        android:inputType="phone"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/etTargetNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="شماره مقصد (مثلا 0935...)"
        android:inputType="phone"
        android:layout_marginBottom="20dp"/>

    <Switch
        android:id="@+id/switchEnable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="فعال بودن فوروارد خودکار"
        android:textSize="16sp"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ذخیره تنظیمات"/>

</LinearLayout>
